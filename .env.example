# ==================== Agent Market 环境变量配置示例 ====================
# 复制此文件为 .env 并填写实际值
# ================================================================

# ==================== JWT配置 ====================
# ⚠️ 生成强随机字符串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==================== 邮件服务配置 ====================
# ⚠️ Gmail需要配置应用专用密码：https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ==================== 前端URL ====================
# ⚠️ 生产环境必须是实际域名，不要使用 localhost
FRONTEND_URL=http://localhost:5173

# ==================== 数据库配置 ====================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zhizhi_agent
PG_USER=postgres
PG_PASSWORD=your-database-password

# ==================== 其他配置 ====================
NODE_ENV=development

# ==================== 功能开关 ====================
# 是否启用密码找回功能
ENABLE_PASSWORD_RESET=true

# 是否启用密码修改功能
ENABLE_PASSWORD_CHANGE=true

# 是否启用Token刷新
ENABLE_TOKEN_REFRESH=true

# 是否启用登录日志
ENABLE_LOGIN_LOG=true

# 是否启用可疑登录检测
ENABLE_ANOMALY_DETECTION=true

# ==================== 安全配置 ====================
# Token过期时间（分钟）
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080  # 7天

# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 密码复杂度要求
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# 登录失败次数限制（多少次后锁定）
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30  # 分钟

# ==================== 日志配置 ====================
# 日志级别：error, warn, info, debug
LOG_LEVEL=info

# 日志文件路径
LOG_PATH=logs

# 是否启用详细日志
VERBOSE_LOG=false
