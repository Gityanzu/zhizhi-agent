# 大模型配置（支持 OpenAI 兼容接口，如通义千问、智谱AI等）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.8-flash
EMBEDDING_MODEL_NAME=text-embedding-v2

# 服务器配置
PORT=3001

# PostgreSQL 配置（可选，不配置则使用 JSON 文件存储）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zhizhi_agent
PG_USER=postgres
PG_PASSWORD=your_password

# 向量数据库配置
CHROMA_COLLECTION_NAME=zhizhi_knowledge_base

# 邮件服务配置（可选，用于邮箱验证、密码重置等功能）
# SMTP 服务器地址（如：smtp.qq.com, smtp.163.com, smtp.gmail.com）
SMTP_HOST=
# SMTP 端口（587 用于 TLS, 465 用于 SSL）
SMTP_PORT=587
# 是否使用加密连接 (true/false)
SMTP_SECURE=false
# SMTP 用户名（邮箱地址）
SMTP_USER=
# SMTP 密码（可能是授权码，不是登录密码）
SMTP_PASS=
# 发件人显示名称和邮箱
SMTP_FROM="智知 <noreply@zhizhi.ai>"

# Redis 缓存配置（可选，用于高性能缓存、会话存储、限流等）
# Redis 服务器地址
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 密码（可选）
REDIS_PASSWORD=
# Redis 数据库编号（0-15）
REDIS_DB=0

# 数据目录
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
CHROMA_DIR=../data/chroma
