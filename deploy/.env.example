# 复制为 deploy/.env 后填写（docker compose 自动读取同目录 .env）
# ⚠ 真实密钥不要提交 git

# LLM（必填，否则对话不可用）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.8-flash
EMBEDDING_MODEL_NAME=text-embedding-v2

# PostgreSQL（compose 内置，改库名/密码即可）
PG_DATABASE=zhizhi_agent
PG_USER=postgres
PG_PASSWORD=postgres

# Web 访问端口（浏览器打开 http://localhost:8080）
WEB_PORT=8080

# 镜像名（流水线会覆盖为带 git sha 的 tag）
SERVER_IMAGE=zhizhi-server:local
CLIENT_IMAGE=zhizhi-client:local

# 邮件（可选，用于找回密码）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
